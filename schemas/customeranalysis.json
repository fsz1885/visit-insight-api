{
  "$defs": {
    "Claim": {
      "additionalProperties": false,
      "properties": {
        "text": {
          "maxLength": 1500,
          "minLength": 1,
          "title": "Text",
          "type": "string"
        },
        "status": {
          "enum": [
            "明确",
            "推断",
            "待验证",
            "冲突",
            "明确否定"
          ],
          "title": "Status",
          "type": "string"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "maxItems": 12,
          "title": "Evidence Refs",
          "type": "array"
        }
      },
      "required": [
        "text",
        "status",
        "evidence_refs"
      ],
      "title": "Claim",
      "type": "object"
    },
    "Maturity": {
      "additionalProperties": false,
      "properties": {
        "name": {
          "title": "Name",
          "type": "string"
        },
        "state": {
          "enum": [
            "已稳定",
            "发育中",
            "待确认"
          ],
          "title": "State",
          "type": "string"
        },
        "detail": {
          "$ref": "#/$defs/Claim"
        }
      },
      "required": [
        "name",
        "state",
        "detail"
      ],
      "title": "Maturity",
      "type": "object"
    },
    "NeedRow": {
      "additionalProperties": false,
      "properties": {
        "must": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 5,
          "title": "Must",
          "type": "array"
        },
        "want": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 5,
          "title": "Want",
          "type": "array"
        },
        "excluded": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 3,
          "title": "Excluded",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "maxItems": 4,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "must",
        "want",
        "excluded",
        "unknowns"
      ],
      "title": "NeedRow",
      "type": "object"
    },
    "Needs": {
      "additionalProperties": false,
      "properties": {
        "who": {
          "$ref": "#/$defs/NeedRow"
        },
        "what": {
          "$ref": "#/$defs/NeedRow"
        },
        "why": {
          "$ref": "#/$defs/NeedRow"
        },
        "when": {
          "$ref": "#/$defs/NeedRow"
        },
        "where": {
          "$ref": "#/$defs/NeedRow"
        },
        "how": {
          "$ref": "#/$defs/NeedRow"
        },
        "how_much": {
          "$ref": "#/$defs/NeedRow"
        }
      },
      "required": [
        "who",
        "what",
        "why",
        "when",
        "where",
        "how",
        "how_much"
      ],
      "title": "Needs",
      "type": "object"
    },
    "Profile": {
      "additionalProperties": false,
      "properties": {
        "motivations": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 6,
          "title": "Motivations",
          "type": "array"
        },
        "household": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 6,
          "title": "Household",
          "type": "array"
        },
        "decision_roles": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 6,
          "title": "Decision Roles",
          "type": "array"
        },
        "communication": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 4,
          "title": "Communication",
          "type": "array"
        },
        "behavior_hypotheses": {
          "items": {
            "$ref": "#/$defs/Claim"
          },
          "maxItems": 3,
          "title": "Behavior Hypotheses",
          "type": "array"
        }
      },
      "required": [
        "motivations",
        "household",
        "decision_roles",
        "communication",
        "behavior_hypotheses"
      ],
      "title": "Profile",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "profile": {
      "$ref": "#/$defs/Profile"
    },
    "needs": {
      "$ref": "#/$defs/Needs"
    },
    "maturity": {
      "items": {
        "$ref": "#/$defs/Maturity"
      },
      "maxItems": 10,
      "title": "Maturity",
      "type": "array"
    },
    "core_tension": {
      "anyOf": [
        {
          "$ref": "#/$defs/Claim"
        },
        {
          "type": "null"
        }
      ]
    },
    "blind_spots": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Blind Spots",
      "type": "array"
    }
  },
  "required": [
    "profile",
    "needs",
    "maturity",
    "core_tension",
    "blind_spots"
  ],
  "title": "CustomerAnalysis",
  "type": "object"
}