# Copy to .env. Use a Kimi Code key, not a Moonshot platform key.
KIMI_CODE_API_KEY=
KIMI_CODE_BASE_URL=https://api.kimi.com/coding/v1
KIMI_CODE_REASONING_EFFORT=high
KIMI_CODE_TIMEOUT=600
KIMI_CODE_CONCURRENCY=8
KIMI_CODE_MODEL=k3
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-pro
DEEPSEEK_REASONING_EFFORT=high
# Docker API deployment: choose deepseek or kimi; this token protects all customer data.
LLM_PROVIDER=deepseek
VISIT_API_TOKEN=
VISIT_PORT=8767
# Saved web settings take priority for non-secret options. No automatic model fallback.
